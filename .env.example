# Local development database settings. This file is git-ignored (see `.env*` in .gitignore).
# Never commit real values. Replace every REPLACE_ME with your approved local credentials.

# Used by the Prisma CLI (prisma db pull, prisma generate) via prisma7.config.ts.
# If the password contains special characters (@ : / ? # & % etc.), percent-encode
# them ONLY in this URL, e.g. @ -> %40, # -> %23, : -> %3A, / -> %2F, % -> %25.
DATABASE_URL="mysql://REPLACE_ME_USER:REPLACE_ME_PASSWORD@127.0.0.1:3306/prisma_playground"

# Used at runtime by the MariaDB/MySQL driver adapter (lib/prisma.ts).
# These are plain values: do NOT percent-encode the password here.
DATABASE_HOST="127.0.0.1"
DATABASE_PORT=3306
DATABASE_USER="REPLACE_ME_USER"
DATABASE_PASSWORD="REPLACE_ME_PASSWORD"
DATABASE_NAME="prisma_playground"
